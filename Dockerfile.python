# ===================================================================
# Dockerfile.python — Generador de tráfico + pipeline ML
# Base: Python 3.11 slim
# Servicios que corre:
#   - default_generator.py  (captura de red → CSV cada 10 min)
#   - Controller.py / score_csv.py  (scoring bajo demanda desde Spring)
# ===================================================================
FROM python:3.11-slim

# --- Dependencias del sistema ---
RUN apt-get update && apt-get install -y --no-install-recommends \
    libpcap-dev \
    tcpdump \
    iproute2 \
    git \
    && rm -rf /var/lib/apt/lists/*

RUN git clone https://github.com/ng-g-c-Nathan/network-anomaly-scoring /app

# --- Directorio de trabajo ---
WORKDIR /app

# --- Dependencias Python ---
RUN pip install --no-cache-dir \
    scapy \
    pandas \
    numpy \
    scikit-learn \
    joblib

# --- Carpetas de salida (volúmenes compartidos) ---
RUN mkdir -p /app/daily /app/models

# --- Script de arranque ---
COPY scripts/entrypoint-python.sh /entrypoint-python.sh
RUN chmod +x /entrypoint-python.sh

ENTRYPOINT ["/entrypoint-python.sh"]