# ===================================================================
# Dockerfile.angular — Frontend Angular (multi-stage build)
# Stage 1: compila con Node + Angular CLI
# Stage 2: sirve el dist con nginx
# ===================================================================

# --- Stage 1: Build ---
FROM node:20-alpine AS builder

# git no viene en alpine por defecto
RUN apk add --no-cache git

WORKDIR /app

RUN npm install -g @angular/cli

RUN git clone https://github.com/ng-g-c-Nathan/AngularInterfaceForOpenVPN /app

RUN npm install

RUN ng build --configuration production

# --- Stage 2: Serve ---
FROM nginx:alpine

COPY --from=builder /app/dist/Conqueror /usr/share/nginx/html/Conqueror

COPY config/nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80