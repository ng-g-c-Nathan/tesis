# ===================================================================
# Dockerfile.angular — Frontend Angular (dist pre-compilado)
# Sirve el build de producción con nginx en el puerto 80.
# El dist ya viene compilado en el repo en dist/Conqueror/
# ===================================================================
FROM nginx:alpine

RUN apk add --no-cache git && \
    git clone https://github.com/ng-g-c-Nathan/AngularInterfaceForOpenVPN /tmp/angular && \
    cp -r /tmp/angular/dist/Conqueror /usr/share/nginx/html/Conqueror && \
    rm -rf /tmp/angular

COPY config/nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80