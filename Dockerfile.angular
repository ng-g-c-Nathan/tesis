# ===================================================================
# Dockerfile.angular — Frontend Angular (dist pre-compilado)
# Angular 17+ compila en dist/Conqueror/browser/
# ===================================================================
FROM nginx:alpine

RUN apk add --no-cache git && \
    git clone https://github.com/ng-g-c-Nathan/AngularInterfaceForOpenVPN /tmp/angular && \
    cp -r /tmp/angular/dist/Conqueror/browser /usr/share/nginx/html/conqueror && \
    rm -rf /tmp/angular

COPY config/nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80